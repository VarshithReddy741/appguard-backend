# Copy this to .env and fill in real values. Never commit .env.

PORT=3000

# --- Storage (Redis, so device pairing + Google Tasks connection survive
# restarts -- Render's own disk is wiped on every redeploy/idle spin-down) ---
# Sign up free at https://console.upstash.com -> Create database (Redis,
# regional is fine) -> REST API section has both values below.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# NOTIFY_METHOD = "email" or "sms"
NOTIFY_METHOD=email

# --- Email (used when NOTIFY_METHOD=email) ---
# Sent via Brevo's HTTPS API (not SMTP -- most free hosts block outbound
# SMTP ports). Sign up free at https://www.brevo.com, verify a sender
# email under account menu > Settings > Senders, Domains, IPs > Senders,
# then get an API key under account menu > SMTP & API > API Keys & MCP.
BREVO_API_KEY=
# Must be the exact email address you verified as a sender in Brevo.
SMTP_FROM=

# --- SMS (used when NOTIFY_METHOD=sms) ---
# From https://console.twilio.com
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Google Tasks (optional, for gating unlocks on pending tasks) ---
# 1. https://console.cloud.google.com/apis/library/tasks.googleapis.com -> Enable
# 2. https://console.cloud.google.com/apis/credentials -> Create Credentials ->
#    OAuth client ID -> "Web application" -> add the redirect URI below.
# 3. Set ADMIN_TOKEN to any random string you make up yourself; it's just a
#    password to your /auth/google and /api/tasks routes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-host/auth/google/callback
ADMIN_TOKEN=
