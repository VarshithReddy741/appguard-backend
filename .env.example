# Copy this to .env and fill in real values. Never commit .env.

PORT=3000

# NOTIFY_METHOD = "email" or "sms"
NOTIFY_METHOD=email

# --- Email (used when NOTIFY_METHOD=email) ---
# Example for Gmail: host=smtp.gmail.com, port=587, user=you@gmail.com,
# pass = a 16-character Gmail "App Password" (not your normal password) --
# generate one at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- SMS (used when NOTIFY_METHOD=sms) ---
# From https://console.twilio.com
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
