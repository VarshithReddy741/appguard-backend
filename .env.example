# Copy this to .env and fill in real values. Never commit .env.

PORT=3000

# NOTIFY_METHOD = "email" or "sms"
NOTIFY_METHOD=email

# --- Email (used when NOTIFY_METHOD=email) ---
# Sent via Brevo's HTTPS API (not SMTP -- most free hosts block outbound
# SMTP ports). Sign up free at https://www.brevo.com, verify a sender
# email under account menu > Settings > Senders, Domains, IPs > Senders,
# then get an API key under account menu > SMTP & API > API Keys & MCP.
BREVO_API_KEY=
# Must be the exact email address you verified as a sender in Brevo.
SMTP_FROM=

# --- SMS (used when NOTIFY_METHOD=sms) ---
# From https://console.twilio.com
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
